# Gemini API Configuration (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here
SMRITI_LLM_MODEL=gemini-2.5-flash
SMRITI_EMBEDDING_MODEL=gemini-embedding-001

# Optional OpenAI / Sarvam-compatible endpoint fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Default Memory Budget (Tokens)
SMRITI_TOKEN_BUDGET=1500
SMRITI_DB_PATH=artifacts/smriti_demo.db
